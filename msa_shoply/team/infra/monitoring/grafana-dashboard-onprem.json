{
  "title": "Shoply 온프레미스 — 부하 실험",
  "uid": "shoply-onprem-v4",
  "schemaVersion": 36,
  "version": 14,
  "refresh": "5s",
  "time": {
    "from": "now-20m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "📊 현황",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "동시접속 VU",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum(k6_vus)",
          "legendFormat": " "
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "orange",
                "value": 500
              },
              {
                "color": "red",
                "value": 1500
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "title": "전체 RPS",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum(rate(gateway_http_duration_seconds_count{route!~\"/health|/metrics\"}[1m]))",
          "legendFormat": " "
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 200
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "title": "실패율",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum(rate(k6_http_reqs_total{expected_response=\"false\"}[1m])) / clamp_min(sum(rate(k6_http_reqs_total[1m])),0.001) * 100",
          "legendFormat": " "
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "title": "Running 파드",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum(kube_pod_status_phase{namespace=\"shoply\",phase=\"Running\"}==1) or on() vector(0)",
          "legendFormat": " "
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "green",
                "value": 10
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 10,
      "title": "🚨 한계 & 스케일 (온프레 핵심)",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 11,
      "title": "⚠️ Pending Pod 추이",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum(kube_pod_status_phase{namespace=\"shoply\",phase=\"Pending\"}==1) or on() vector(0)",
          "legendFormat": "Pending"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 12,
      "title": "워커 CPU (%) — worker1·2",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "100 - avg by(node)(rate(node_cpu_seconds_total{job=\"node-onprem\",node=~\"worker[12]\",mode=\"idle\"}[1m]))*100",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "percent",
          "max": 100,
          "min": 0
        }
      }
    },
    {
      "id": 13,
      "title": "워커 메모리 (%) — worker1·2",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "(1 - node_memory_MemAvailable_bytes{job=\"node-onprem\",node=~\"worker[12]\"} / node_memory_MemTotal_bytes{job=\"node-onprem\",node=~\"worker[12]\"})*100",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "percent",
          "max": 100,
          "min": 0
        }
      }
    },
    {
      "id": 14,
      "title": "HPA Current vs Desired (order·payment)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"shoply\",horizontalpodautoscaler=~\"order-hpa|payment-hpa\"}",
          "legendFormat": "{{horizontalpodautoscaler}} cur"
        },
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"shoply\",horizontalpodautoscaler=~\"order-hpa|payment-hpa\"}",
          "legendFormat": "{{horizontalpodautoscaler}} des"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 15,
      "title": "파드 재시작 (5분) — order·payment",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum by (container)(increase(kube_pod_container_status_restarts_total{namespace=\"shoply\",container=~\"order|payment\"}[5m]))",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 20,
      "title": "⚡ 성능 (order·payment)",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 21,
      "title": "RPS (order·payment)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum(rate(order_service_http_duration_seconds_count{route!~\"/health|/metrics\"}[1m]))",
          "legendFormat": "order"
        },
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum(rate(payment_service_http_duration_seconds_count{route!~\"/health|/metrics\"}[1m]))",
          "legendFormat": "payment"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 22,
      "title": "P95 응답시간 (order·payment)",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "histogram_quantile(0.95,sum by(le)(rate(order_service_http_duration_seconds_bucket{route!~\"/health|/metrics\"}[1m])))",
          "legendFormat": "order"
        },
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "histogram_quantile(0.95,sum by(le)(rate(payment_service_http_duration_seconds_bucket{route!~\"/health|/metrics\"}[1m])))",
          "legendFormat": "payment"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "s"
        }
      }
    },
    {
      "id": 23,
      "title": "주문 상태별 (201/409/5xx)",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum(rate(order_service_http_duration_seconds_count{method=\"POST\",status=\"201\"}[1m]))",
          "legendFormat": "성공(201)"
        },
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum(rate(order_service_http_duration_seconds_count{method=\"POST\",status=\"409\"}[1m]))",
          "legendFormat": "충돌(409)"
        },
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum(rate(order_service_http_duration_seconds_count{method=\"POST\",status=~\"5..\"}[1m]))",
          "legendFormat": "에러(5xx)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 30,
      "title": "📦 order·payment 파드 (cAdvisor)",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 31,
      "title": "order·payment CPU (%) — 서비스 합계",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum by (service)(label_replace(rate(container_cpu_usage_seconds_total{namespace=\"shoply\",pod=~\"order.*|payment.*\",container!=\"\",container!=\"POD\"}[1m]),\"service\",\"$1\",\"pod\",\"([a-z]+)-.*\"))*100",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "percent"
        }
      }
    },
    {
      "id": 32,
      "title": "order·payment 메모리 (MB) — 서비스 합계",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum by (service)(label_replace(container_memory_working_set_bytes{namespace=\"shoply\",pod=~\"order.*|payment.*\",container!=\"\",container!=\"POD\"},\"service\",\"$1\",\"pod\",\"([a-z]+)-.*\"))/1024/1024",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "decmbytes"
        }
      }
    },
    {
      "id": 40,
      "title": "📋 로그 / 이벤트 (Loki)",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 41,
      "title": "shoply 앱 로그 (probe 제외)",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki"
          },
          "expr": "{namespace=\"shoply\"} != \"kube-probe\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    },
    {
      "id": 42,
      "title": "k8s 이벤트 (Pending·스케일)",
      "type": "logs",
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki"
          },
          "expr": "{source=\"kubernetes-events\"} | json | line_format \"[{{.type}}] {{.reason}} {{.involvedObject_kind}}/{{.involvedObject_name}}: {{.message}}\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    }
  ]
}