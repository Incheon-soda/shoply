      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 51,
      "title": "워커 CPU (%) — 최대 200%",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum by (instance) (rate(node_cpu_seconds_total{mode!=\"idle\",mode!=\"iowait\",job=\"node-onprem\",instance=~\"10.0.5.119:3910.\"}[1m]))*100",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 200,
          "custom": {
            "lineWidth": 2
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 140
              },
              {
                "color": "red",
                "value": 180
              }
            ]
          }
        }
      }
    },
    {
      "id": 52,
      "title": "워커 메모리 사용량 (GB / 4GB)",
