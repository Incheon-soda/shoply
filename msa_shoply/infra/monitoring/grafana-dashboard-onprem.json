      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "rate(payment_processed_total{status=\"PAID\"}[1m])",
          "legendFormat": "성공 (PAID)"
        },
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "rate(payment_processed_total{status=\"FAILED\"}[1m])",
          "legendFormat": "실패 (FAILED)"
        }
