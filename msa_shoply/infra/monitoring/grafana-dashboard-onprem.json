    },
    {
      "id": 42,
      "title": "주문 상태별 RPS",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 33,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum(rate(order_service_http_duration_seconds_count{method=\"POST\",status=\"201\"}[1m]))",
          "legendFormat": "성공 (201)"
