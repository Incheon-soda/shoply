      "gridPos": {
        "x": 8,
        "y": 42,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "(node_memory_MemTotal_bytes{job=\"node-onprem\",instance=~\"10.0.5.119:3910.\"}-node_memory_MemAvailable_bytes{job=\"node-onprem\",instance=~\"10.0.5.119:3910.\"})/1024/1024/1024",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "custom": {
            "lineWidth": 2
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3
              },
              {
                "color": "red",
                "value": 3.8
              }
            ]
          }
        }
      }
    },
