      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "rate(redis_keyspace_hits_total{job=\"redis-onprem\"}[1m])/(rate(redis_keyspace_hits_total{job=\"redis-onprem\"}[1m])+rate(redis_keyspace_misses_total{job=\"redis-onprem\"}[1m]))*100",
          "legendFormat": "히트율 %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 50,
      "title": "🖥️ 인프라 & 파드",
